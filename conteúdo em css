ody {
    font-family: Arial, sans-serif;
    background-color: #222;
    color: white;
    text-align: center;
    padding: 50px;
}

.container {
    max-width: 600px;
    margin: auto;
}

input {
    width: 300px;
    padding: 12px;
    font-size: 16px;
}

button {
    padding: 12px 20px;
    margin-left: 5px;
    background-color: orange;
    color: white;
    border: none;
    cursor: pointer;
}

button:hover {
    background-color: darkorange;
}

#resultado {
    margin-top: 30px;
}

.card {
    background-color: white;
    color: black;
    padding: 20px;
    border-radius: 10px;
}

.card img {
    width: 250px;
    height: 300px;
    object-fit: contain;
}

.erro {
    color: red;
}
